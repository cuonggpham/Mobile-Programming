<?xml version="1.0" encoding="utf-8"?>
<LinearLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@android:color/white"
    android:paddingVertical="16dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp"
        android:gravity="center_vertical">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@android:drawable/ic_menu_sort_by_size"
            android:contentDescription="Sort"
            android:tint="?attr/colorPrimary" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:text="Sort by"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@android:color/black" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E0E0E0"
        android:layout_marginVertical="8dp" />

    <!-- Sort Options -->
    <RadioGroup
        android:id="@+id/sortRadioGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Name A-Z -->
        <RadioButton
            android:id="@+id/sortByNameAsc"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:paddingHorizontal="16dp"
            android:text="Name (A to Z)"
            android:textSize="16sp"
            android:textColor="@android:color/black" />

        <!-- Name Z-A -->
        <RadioButton
            android:id="@+id/sortByNameDesc"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:paddingHorizontal="16dp"
            android:text="Name (Z to A)"
            android:textSize="16sp"
            android:textColor="@android:color/black" />

        <!-- Date (Newest) -->
        <RadioButton
            android:id="@+id/sortByDateDesc"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:paddingHorizontal="16dp"
            android:text="Date (Newest first)"
            android:textSize="16sp"
            android:textColor="@android:color/black" />

        <!-- Date (Oldest) -->
        <RadioButton
            android:id="@+id/sortByDateAsc"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:paddingHorizontal="16dp"
            android:text="Date (Oldest first)"
            android:textSize="16sp"
            android:textColor="@android:color/black" />

        <!-- Size (Largest) -->
        <RadioButton
            android:id="@+id/sortBySizeDesc"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:paddingHorizontal="16dp"
            android:text="Size (Largest first)"
            android:textSize="16sp"
            android:textColor="@android:color/black" />

        <!-- Size (Smallest) -->
        <RadioButton
            android:id="@+id/sortBySizeAsc"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:paddingHorizontal="16dp"
            android:text="Size (Smallest first)"
            android:textSize="16sp"
            android:textColor="@android:color/black" />

        <!-- Type -->
        <RadioButton
            android:id="@+id/sortByType"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:paddingHorizontal="16dp"
            android:text="Type"
            android:textSize="16sp"
            android:textColor="@android:color/black" />

    </RadioGroup>

</LinearLayout>
